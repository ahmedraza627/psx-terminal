# PSX / NCCPL Quant Terminal - environment template
# Copy to .env (pipeline) and frontend/.env.local (dashboard) and fill in.
# ---- Supabase (pipeline + dashboard) ----
# Project Settings -> API in the Supabase dashboard
SUPABASE_URL=https://YOURPROJECT.supabase.co
# Service role key for the pipeline (CI) - never expose this to the browser
SUPABASE_KEY=your-service-role-key
# Anon key for the dashboard (RLS must allow public SELECT)
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Pipeline tuning (optional, sensible defaults) ----
# Minimum NDM/off-market share volume to record as a block deal
OFFMARKET_MIN_VOLUME=10000
# Require off-market block confirmation for SHORT_TERM signals (true/false)
OFFMARKET_REQUIRED=false
# Whale Radar (stealth accumulation) thresholds
WHALE_VOL_MULT=1.8
WHALE_DRIFT_MIN=-2.0
WHALE_DRIFT_MAX=4.0
WHALE_MIN_LIQUIDITY=30000
WHALE_FALLBACK_TOP_N=5
# Cash & carry arbitrage desk
SPREAD_MIN_PCT=2.5
ANNUALIZATION_DAYS=30
# Institutional momentum (smart-money sector alignment)
BREAKOUT_MIN_MULT=1.5
TARGETS_PER_SECTOR=1
MOMENTUM_CAP=15
MOMENTUM_FALLBACK_TOP_N=5
# Shared liquidity / signal-cap filters
MIN_AVG_VOLUME=50000
SIGNALS_MAX_PER_HORIZON=40
# Long-term dividend screen thresholds
DIV_YIELD_MIN=6.0
PE_MAX=12.0
MARKET_CAP_MIN_PKR=5000000000
# Institutional inflow streak (trading days) required for MEDIUM_TERM
MEDIUM_TERM_STREAK_DAYS=4
# SECP insider / sponsor accumulation radar
INSIDER_LOOKBACK_DAYS=20
INSIDER_MIN_NOTIONAL=5000000
INSIDER_ULTRA_HIGH_NOTIONAL_PKR=10000000
INSIDER_MAX_ROWS=400
# NCCPL MTS leverage cascade / flushout hunter
MTS_LOOKBACK_DAYS=5
MTS_UTIL_SPIKE=80.0
MTS_VALUE_DROP_PCT=25.0
MTS_PRICE_DROP_PCT=10.0
# Rollover desk (futures basis inversion / short squeeze)
BASIS_INVERSION_PCT=-0.5
ROLLOVER_SQUEEZE_PCT=1.5
# Optional fallback source for futures contract prices (page serving the
# SYMBOL/OPEN/HIGH/LOW/CURRENT/CHANGE/VOLUME table shape with XXX-FUT
# symbols). Used only when the PSX market-summary AJAX is WAF-blocked.
FUTURES_FALLBACK_URL=
# Historical edge backtester (forward 5/10/20-session evaluation)
# Reward-to-risk bar for a signal to count as a "hit" (entry + R x stop distance)
BACKTEST_TARGET_R=2.0
# Stop geometry: stop = entry - ATR_STOP_MULT x ATR(14). Calibrated by the
# 807-row stop sweep (2026-09): 1.5x is the expectancy peak of the 1.5-3.0x
# grid at every reward bar tested (E[R] -0.13 / PF 0.82 vs 2.0x -0.18 / 0.75;
# the gradient continues below 1x ATR but sub-ATR stops are execution-
# impractical on PSX spreads). Was 2.0x before the sweep.
ATR_STOP_MULT=1.5
# Walk-forward seed: re-simulate signals over the trailing N sessions so
# Edge Lab win rates populate immediately (existing live sessions are skipped)
BACKTEST_SEED_SESSIONS=30
BACKTEST_SEED_SKIP_EXISTING=true
# Institutional risk / position sizing (main.py default equity; --equity overrides)
RISK_PER_TRADE_PCT=1.0
RISK_MAX_PORTFOLIO_HEAT_PCT=6.0
RISK_MAX_POSITION_PCT=20.0
RISK_MAX_POSITIONS=8
# Noise floor sits at the calibrated 1.5x-ATR stop (~1.1% median distance),
# so the engine's own geometry passes sizing instead of being re-widened.
RISK_MIN_STOP_DISTANCE_PCT=1.0
PORTFOLIO_EQUITY_PKR=5000000
# Fallback USD/PKR rate if the free FX API is unreachable
FALLBACK_USD_PKR=284.0
# ------------------------- Fundamental Alpha & Research Layer ----------------#
# Quarterly financials scrape (DPS company pages, liquidity-ranked universe)
FINANCIALS_MAX_TICKERS=80
FINANCIALS_POLITE_SLEEP=0.4
# Alpha score weights (cross-sectionally normalised; sum is renormalised to 100)
ALPHA_W_VALUATION=35
ALPHA_W_QUALITY=25
ALPHA_W_GROWTH=20
ALPHA_W_YIELD=20
# Valuation bands (discount % vs PSX institutional intrinsic value)
ALPHA_UNDERVALUED_BAND_PCT=15
ALPHA_OVERVALUED_BAND_PCT=-15
# ---------------- PSX Institutional Valuation Model (PSX_MF_V1) --------------#
# (US Graham EPV retired - its 4.4/y bond factor mis-prices PKR names under
#  13-15% PIB yields.)
# Sector target P/Es for the earnings-power leg
ALPHA_PE_EP=6.0
ALPHA_PE_FERTILIZER=7.5
ALPHA_PE_CEMENT=7.0
ALPHA_PE_TECH=12.0
ALPHA_PE_BANKS=5.0
ALPHA_PE_DEFAULT=6.5
# Dividend floor leg: K_e = PIB yield - dividend growth
ALPHA_PIB_YIELD_PCT=13.5
ALPHA_DIV_GROWTH_PCT=4.0
# Composite blend for regular dividend payers: PE leg + dividend floor leg
ALPHA_W_PE_VALUE=0.60
ALPHA_W_DIV_FLOOR=0.40
# ------------------------- KIBOR Easing Sensitivity --------------------------#
KIBOR_CURRENT_PCT=13.5
KIBOR_TAX_RATE_PCT=29.0
KIBOR_DEBT_TURNOVER_X=4.0
# Operator-supplied floating debt (PSX publishes no debt columns):
# comma map "OGDC:185b,PSO:120b,LUCK:95b" and/or a ticker,debt_pkr CSV URL
KIBOR_FLOATING_DEBT_MAP=
KIBOR_DEBT_CSV_URL=
# ------------------------- Sector rotation (RRG) vs KSE-100 ------------------#
RRG_LOOKBACK_SESSIONS=60
RRG_JACOB_SPAN=5
RRG_MIN_SECTOR_MEMBERS=4
RRG_BENCHMARK=KSE100
