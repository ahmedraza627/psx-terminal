<file path="frontend/components/VwapExecutionDesk.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Badge, DataTable, DeskFrame, IdleState, Row } from "@/components/ui/primitives";
import { fmtInt, fmtPct, fmtPrice } from "@/components/ui/format";
import { fetchTickerOhlcv, type OhlcvRow } from "@/lib/deskQueries";

/**
 * Execution slippage & block VWAP calculator.
 *
 * Model (standard square-root market-impact form, Almgren-Chriss style):
 *   impact_pct = k * sigma_daily * sqrt(Q / ADV)
 * where sigma_daily is estimated from the ticker's stored 5-session true
 * range (high-low)/close mean, ADV = 20-session average volume, and k scales
 * with urgency (0.6 patient / 1.0 normal / 1.6 urgent). Participation caps
 * the per-session child quantity at 15% of ADV; the VWAP window is
 * ceil(Q / (0.15 * ADV)) sessions. Limit spread suggestion: place passive
 * child orders between the 5-day mean close-to-close spread band.
 *
 * Every input is real: OHLCV comes from psx_daily_eod. The impact constant
 * is a documented industry heuristic, NOT a fitted model — disclosed in the
 * footer so dealers can recalibrate k to their own fills.
 */
const URGENCIES = {
  PATIENT: { k: 0.6, capPctAdv: 0.08 },
  NORMAL: { k: 1.0, capPctAdv: 0.15 },
  URGENT: { k: 1.6, capPctAdv: 0.30 },
} as const;

type Urgency = keyof typeof URGENCIES;

export default function VwapExecutionDesk() {
  const [tickerInput, setTickerInput] = useState("");
  const [ticker, setTicker] = useState<string | null>(null);
  const [shares, setShares] = useState(100000);
  const [urgency, setUrgency] = useState<Urgency>("NORMAL");
  const [bars, setBars] = useState<OhlcvRow[]>([]);
  const [loading, setLoading] = useState(false);

  useEffect(() => {
    let cancelled = false;
    if (!ticker) {
      setBars([]);
      return;
    }
    setLoading(true);
    fetchTickerOhlcv(ticker, 20)
      .then((rows) => {
        if (!cancelled) setBars(rows);
      })
      .finally(() => {
        if (!cancelled) setLoading(false);
      });
    return () => {
      cancelled = true;
    };
  }, [ticker]);

  const model = useMemo(() => {
    if (bars.length === 0) return null;
    const closes = bars.map((b) => b.close).filter((c): c is number => c != null);
    const vols = bars.map((b) => b.volume).filter((v): v is number => v != null);
    if (closes.length < 3 || vols.length < 3) return null;
    const adv = vols.reduce((a, v) => a + v, 0) / vols.length;
    if (adv <= 0) return null;
    // Daily sigma from true range proxy.
    const trs = bars
      .filter((b) => b.high != null && b.low != null && b.close != null)
      .map(
        (b) =>
          ((b.high as number) - (b.low as number)) / (b.close as number)
      );
    const sigma = trs.length > 0 ? trs.reduce((a, v) => a + v, 0) / trs.length : 0.02;
    const cfg = URGENCIES[urgency];
    const participation = Math.max(
      cfg.capPctAdv,
      Math.min(0.9, shares / adv)
    );
    const impactPct = cfg.k * sigma * Math.sqrt(shares / adv) * 100;
    const sessions = Math.max(1, Math.ceil(participation / cfg.capPctAdv));
    const lastClose = closes[0];
    const impactPkrPerShare = (lastClose * impactPct) / 100;
    // Optimal limit: post inside the first half of the estimated impact band.
    const limitBid = lastClose - impactPkrPerShare * 0.5;
    const vwaps = bars
      .filter((b) => b.close != null && b.volume != null && (b.volume as number) > 0)
      .slice(0, 5)
      .map((b) => (b.close as number) * (b.volume as number));
    const refVwap =
      vwaps.length > 0
        ? vwaps.reduce((a, v) => a + v, 0) / vwaps.length
        : null;
    return {
      adv,
      sigmaPct: sigma * 100,
      impactPct,
      impactPkrTotal: impactPkrPerShare * shares,
      sessions,
      perSessionShares: Math.min(
        shares / sessions,
        adv * cfg.capPctAdv
      ),
      limitBid,
      lastClose,
      refVwap,
      participationPct: participation * 100,
    };
  }, [bars, shares, urgency]);

  return (
    <DeskFrame
      title="Execution Desk — Block VWAP & Slippage"
      right={
        <div className="flex items-center gap-1">
          {(Object.keys(URGENCIES) as Urgency[]).map((u) => (
            <button
              key={u}
              onClick={() => setUrgency(u)}
              className={`rounded-[2px] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider ring-1 ${
                u === urgency
                  ? "bg-info/10 text-info ring-info/30"
                  : "bg-panel text-muted ring-hairline hover:text-ink"
              }`}
            >
              {u}
            </button>
          ))}
        </div>
      }
      footer={
        <p className="font-mono text-[10px] leading-relaxed text-ghost">
          Impact = k · σ_daily · √(Q/ADV); k = {URGENCIES[urgency].k.toFixed(1)} ({urgency.toLowerCase()}), σ from the
          stored 5-session true range, ADV = 20-session mean volume.
          Child-order cap {Math.round(URGENCIES[urgency].capPctAdv * 100)}% of
          ADV per session. Constant k is an industry heuristic — recalibrate
          to your desk&apos;s realized fills.
        </p>
      }
    >
      {/* Inputs */}
      <div className="flex flex-wrap items-end gap-3 border-b border-hairline px-2.5 py-2">
        <div>
          <p className="font-mono text-[9px] uppercase tracking-widest text-ghost">
            TICKER
          </p>
          <div className="flex gap-1">
            <input
              value={tickerInput}
              onChange={(e) => setTickerInput(e.target.value.toUpperCase())}
              onKeyDown={(e) => {
                if (e.key === "Enter" && tickerInput.trim())
                  setTicker(tickerInput.trim().toUpperCase());
              }}
              placeholder="SYM"
              className="h-7 w-24 rounded-[2px] border border-hairline bg-obsidian px-2 font-mono text-[11px] uppercase tracking-wider text-ink placeholder:text-ghost focus:border-info/50 focus:outline-none"
              aria-label="Ticker"
            />
            <button
              onClick={() =>
                tickerInput.trim() && setTicker(tickerInput.trim().toUpperCase())
              }
              className="h-7 rounded-[2px] px-2 font-mono text-[10px] uppercase tracking-wider text-info ring-1 ring-info/30 hover:bg-info/10"
            >
              LOAD
            </button>
          </div>
        </div>
        <div>
          <p className="font-mono text-[9px] uppercase tracking-widest text-ghost">
            TARGET SHARES
          </p>
          <input
            type="number"
            value={shares}
            min={100000}
            step={50000}
            onChange={(e) => setShares(Math.max(100000, Number(e.target.value) || 0))}
            className="h-7 w-36 rounded-[2px] border border-hairline bg-obsidian px-2 font-mono text-[11px] tabular-nums text-ink focus:border-info/50 focus:outline-none"
            aria-label="Target shares"
          />
        </div>
        {ticker && (
          <Badge tone="neutral">{ticker} · 20D LOADED</Badge>
        )}
      </div>

      {!ticker ? (
        <IdleState
          headline="LOAD A TICKER TO PRICE THE BLOCK"
          detail="Impact, VWAP window and limit guidance are computed from stored OHLCV only."
        />
      ) : loading ? (
        <IdleState headline="LOADING OHLCV…" tone="info" />
      ) : !model ? (
        <IdleState
          tone="warn"
          headline="[NO OHLCV HISTORY FOR SYMBOL]"
          detail="psx_daily_eod has fewer than 3 stored sessions for this ticker."
        />
      ) : (
        <DataTable
          minWidth={560}
          columns={[
            { label: "Execution Parameter", width: "40%" },
            { label: "Value", align: "right" },
          ]}
        >
          {[
            { k: "LAST CLOSE", v: fmtPrice(model.lastClose) },
            { k: "ADV (20D)", v: fmtInt(model.adv) },
            { k: "PARTICIPATION", v: `${model.participationPct.toFixed(1)}%` },
            {
              k: "EST. IMPACT SLIPPAGE",
              v: `${fmtPct(model.impactPct, 2)} · PKR ${fmtInt(model.impactPkrTotal)}`,
            },
            {
              k: "VWAP DISTRIBUTION WINDOW",
              v: `${model.sessions} SESSION${model.sessions === 1 ? "" : "S"}`,
            },
            {
              k: "PER-SESSION CHILD QTY",
              v: `${fmtInt(model.perSessionShares)} SHS`,
            },
            {
              k: "OPTIMAL LIMIT (BID SIDE)",
              v: fmtPrice(model.limitBid),
            },
            {
              k: "5D REF VWAP",
              v: model.refVwap != null ? fmtPrice(model.refVwap) : "—",
            },
            { k: "σ DAILY (TRUE RANGE)", v: fmtPct(model.sigmaPct, 2) },
          ].map((r) => (
            <Row key={r.k}>
              <td className="px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-muted">
                {r.k}
              </td>
              <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums text-ink">
                {r.v}
              </td>
            </Row>
          ))}
        </DataTable>
      )}
    </DeskFrame>
  );
}
</file>

<file path="frontend/components/WatchlistDesk.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Badge, DataTable, DeskFrame, Row } from "@/components/ui/primitives";
import { fmtPct, fmtPrice, fmtX, tonePct } from "@/components/ui/format";
import type { WhaleRow } from "@/lib/queries";

/**
 * Multi-tier watchlists persisted in localStorage. Breakout flags come from
 * the live session signals: a ticker holding a WHALE_RADAR / MOMENTUM row
 * with volume >= 2x SMA20 prints BREAKOUT; else quiet.
 */
export const DEFAULT_LISTS: Record<string, string[]> = {
  "ACTIVE PROP IDEAS": [],
  "DIVIDEND YIELD": [],
  "KIBOR PLAYS": [],
};

const LS_KEY = "psx-terminal-watchlists-v1";

function loadLists(): Record<string, string[]> {
  try {
    const raw = window.localStorage.getItem(LS_KEY);
    if (raw) {
      const parsed = JSON.parse(raw) as Record<string, string[]>;
      return { ...DEFAULT_LISTS, ...parsed };
    }
  } catch {
    /* first run */
  }
  return { ...DEFAULT_LISTS };
}

function saveLists(lists: Record<string, string[]>) {
  try {
    window.localStorage.setItem(LS_KEY, JSON.stringify(lists));
  } catch {
    /* storage unavailable (private mode) — lists stay session-local */
  }
}

interface Props {
  whaleRows: WhaleRow[];
  kiborTickers: string[];
  dividendTickers: string[];
  onInspect: (ticker: string) => void;
}

export default function WatchlistDesk({
  whaleRows,
  kiborTickers,
  dividendTickers,
  onInspect,
}: Props) {
  const [lists, setLists] = useState<Record<string, string[]>>(DEFAULT_LISTS);
  const [active, setActive] = useState<string>("ACTIVE PROP IDEAS");
  const [hydrated, setHydrated] = useState(false);

  useEffect(() => {
    setLists(loadLists());
    setHydrated(true);
  }, []);

  // Seed the curated tiers once from live data (only when still empty).
  useEffect(() => {
    if (!hydrated) return;
    const seeds: Record<string, string[]> = {
      "KIBOR PLAYS": kiborTickers.slice(0, 12),
      "DIVIDEND YIELD": dividendTickers.slice(0, 12),
    };
    const next = { ...lists };
    let changed = false;
    for (const [name, seed] of Object.entries(seeds)) {
      if ((next[name] ?? []).length === 0 && seed.length > 0) {
        next[name] = seed;
        changed = true;
      }
    }
    if (changed) {
      setLists(next);
      saveLists(next);
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [hydrated, kiborTickers.join(","), dividendTickers.join(",")]);

  const whaleBy = useMemo(() => {
    const m = new Map<string, WhaleRow>();
    for (const r of whaleRows) m.set(r.ticker.toUpperCase(), r);
    return m;
  }, [whaleRows]);

  const update = (next: Record<string, string[]>) => {
    setLists(next);
    saveLists(next);
  };

  const addTicker = () => {
    const t = (window.prompt("ADD SYMBOL TO " + active) ?? "")
      .trim()
      .toUpperCase();
    if (!t) return;
    const list = lists[active] ?? [];
    if (list.includes(t)) return;
    update({ ...lists, [active]: [...list, t] });
  };

  const removeTicker = (t: string) => {
    update({
      ...lists,
      [active]: (lists[active] ?? []).filter((x) => x !== t),
    });
  };

  const activeList = lists[active] ?? [];

  return (
    <DeskFrame
      title="Institutional Watchlists"
      right={
        <div className="flex items-center gap-1">
          {Object.keys(lists).map((name) => (
            <button
              key={name}
              onClick={() => setActive(name)}
              className={`rounded-[2px] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider ring-1 ${
                name === active
                  ? "bg-info/10 text-info ring-info/30"
                  : "bg-panel text-muted ring-hairline hover:text-ink"
              }`}
            >
              {name} {(lists[name] ?? []).length}
            </button>
          ))}
          <button
            onClick={addTicker}
            className="rounded-[2px] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-info ring-1 ring-info/30 hover:bg-info/10"
          >
            + ADD
          </button>
        </div>
      }
      footer={
        <p className="font-mono text-[10px] leading-relaxed text-ghost">
          Breakout = live-session volume ≥ 2.0× SMA20 on a WHALE_RADAR or
          MOMENTUM signal row. Lists persist locally (localStorage) per desk
          terminal.
        </p>
      }
    >
      {activeList.length === 0 ? (
        <p className="px-2.5 py-4 text-center font-mono text-[10px] uppercase tracking-widest text-ghost">
          EMPTY LIST — + ADD TO BUILD IT
        </p>
      ) : (
        <DataTable
          minWidth={560}
          columns={[
            { label: "Ticker" },
            { label: "LTP", align: "right" },
            { label: "Day %", align: "right" },
            { label: "Vol x20", align: "right" },
            { label: "Stop", align: "right" },
            { label: "State", align: "right" },
            { label: "", align: "right" },
          ]}
        >
          {activeList.map((t) => {
            const w = whaleBy.get(t.toUpperCase());
            const volX = w?.meta.vol_multiple ?? null;
            const breakout =
              volX != null && volX >= 2.0 && w?.meta.conviction != null;
            return (
              <Row key={t}>
                <td className="px-2.5 py-1 font-mono text-[11px] font-semibold text-ink">
                  <button
                    onClick={() => onInspect(t)}
                    className="hover:text-info"
                  >
                    {t}
                  </button>
                </td>
                <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums text-ink">
                  {fmtPrice(w?.entry_reference ?? null)}
                </td>
                <td className="px-2 py-1 text-right">
                  <span
                    className={`font-mono text-[11px] tabular-nums ${tonePct(w?.meta.drift_pct ?? null)}`}
                  >
                    {fmtPct(w?.meta.drift_pct ?? null)}
                  </span>
                </td>
                <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums text-info">
                  {fmtX(volX)}
                </td>
                <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums text-bear">
                  {fmtPrice(w?.stop_loss ?? null)}
                </td>
                <td className="px-2 py-1 text-right">
                  {breakout ? (
                    <Badge tone="bull">BREAKOUT</Badge>
                  ) : w ? (
                    <Badge tone="neutral">QUIET</Badge>
                  ) : (
                    <Badge tone="ghost">NO SESSION DATA</Badge>
                  )}
                </td>
                <td className="px-2 py-1 text-right">
                  <button
                    onClick={() => removeTicker(t)}
                    className="font-mono text-[10px] text-ghost hover:text-bear"
                    aria-label={`Remove ${t}`}
                  >
                    ✕
                  </button>
                </td>
              </Row>
            );
          })}
        </DataTable>
      )}
    </DeskFrame>
  );
}
</file>

<file path="frontend/lib/deskQueries.ts">
/**
 * Desk-level data feeds for the institutional expansion desks (rotation
 * persistence, comparison, portfolio analytics). Every fetcher is
 * settle-safe: failures return empty structures instead of rejecting, so
 * one dead table never takes down a desk (the desk renders its idle state).
 */
import { getSupabase } from "./supabase";

// --------------------------------------------------------------- //
// RRG history across sessions (regime persistence tracking).       //
// --------------------------------------------------------------- //
export interface RotationHistoryRow {
  tradeDate: string;
  sectorName: string;
  quadrant: string;
}

export async function fetchRotationHistory(): Promise<
  RotationHistoryRow[]
> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("psx_sector_rotation")
      .select("trade_date,sector_name,quadrant")
      .order("trade_date", { ascending: false })
      .limit(3000);
    if (error) throw error;
    return ((data ?? []) as unknown as Record<string, unknown>[]).map(
      (r) => ({
        tradeDate: r.trade_date as string,
        sectorName: (r.sector_name as string).toUpperCase(),
        quadrant: (r.quadrant as string) ?? "LAGGING",
      })
    );
  } catch {
    return [];
  }
}

// --------------------------------------------------------------- //
// NCCPL sector-level institutional flows (5-day flow bias).        //
// --------------------------------------------------------------- //
export interface SectorFlowRow {
  sectorName: string;
  /** 5-session net institutional PKR across the named sector. */
  net5dPkr: number;
  /** Latest-session net institutional PKR. */
  netLatestPkr: number;
}

const INST_TYPES = new Set(["MUTUAL FUNDS", "FIPI", "BANKS"]);

export async function fetchSectorFlows(
  sessionDate: string
): Promise<SectorFlowRow[]> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("nccpl_fipi_lipi")
      .select("trade_date,participant_type,sector_name,net_pkr")
      .order("trade_date", { ascending: false })
      .limit(1500);
    if (error) throw error;
    const rows = (data ?? []) as unknown as {
      trade_date: string;
      participant_type: string;
      sector_name: string;
      net_pkr: number | null;
    }[];
    const dates = Array.from(
      new Set(rows.map((r) => r.trade_date))
    )
      .sort()
      .reverse()
      .slice(0, 5);
    const window = new Set(dates);
    const perSector = new Map<string, { w: number; latest: number }>();
    for (const r of rows) {
      if (!window.has(r.trade_date)) continue;
      const sector = (r.sector_name ?? "ALL").toUpperCase();
      if (sector === "ALL" || sector === "") continue;
      if (!INST_TYPES.has((r.participant_type ?? "").toUpperCase().trim()))
        continue;
      const net = r.net_pkr ?? 0;
      const b = perSector.get(sector) ?? { w: 0, latest: 0 };
      b.w += net;
      if (r.trade_date === dates[0]) b.latest += net;
      perSector.set(sector, b);
    }
    void sessionDate; // flows bind to the newest stored session, not signals
    return Array.from(perSector.entries())
      .map(([sectorName, b]) => ({
        sectorName,
        net5dPkr: Math.round(b.w),
        netLatestPkr: Math.round(b.latest),
      }))
      .sort((a, b2) => b2.net5dPkr - a.net5dPkr);
  } catch {
    return [];
  }
}

// --------------------------------------------------------------- //
// Ticker -> sector map from the fundamentals snapshot.             //
// --------------------------------------------------------------- //
export async function fetchTickerSectorMap(): Promise<Map<string, string>> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("psx_fundamentals")
      .select("ticker,sector_name")
      .order("trade_date", { ascending: false })
      .limit(1200);
    if (error) throw error;
    const map = new Map<string, string>();
    for (const r of (data ?? []) as unknown as {
      ticker: string;
      sector_name: string | null;
    }[]) {
      const t = (r.ticker ?? "").toUpperCase().trim();
      const s = (r.sector_name ?? "").toUpperCase().trim();
      if (t && s && !map.has(t)) map.set(t, s);
    }
    return map;
  } catch {
    return new Map();
  }
}

// --------------------------------------------------------------- //
// Fundamentals snapshot (DPS screener) for the comparison desk.    //
// --------------------------------------------------------------- //
export interface FundamentalsRow {
  ticker: string;
  sectorName: string | null;
  marketCapPkr: number | null;
  closePrice: number | null;
  peRatio: number | null;
  dividendYield: number | null;
  freeFloat: number | null;
  volume30dAvg: number | null;
}

export async function fetchFundamentalsRows(
  sessionDate: string
): Promise<FundamentalsRow[]> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("psx_fundamentals")
      .select(
        "trade_date,ticker,sector_name,market_cap_pkr,close_price,"
        + "pe_ratio,dividend_yield,free_float,volume_30d_avg"
      )
      .order("trade_date", { ascending: false })
      .limit(1200);
    if (error) throw error;
    const rows = (data ?? []) as unknown as Record<string, unknown>[];
    // Newest snapshot per ticker (table holds one row per session).
    const seen = new Set<string>();
    const out: FundamentalsRow[] = [];
    for (const r of rows) {
      const ticker = String(r.ticker ?? "").toUpperCase();
      if (!ticker || seen.has(ticker)) continue;
      seen.add(ticker);
      out.push({
        ticker,
        sectorName: (r.sector_name as string | null) ?? null,
        marketCapPkr: (r.market_cap_pkr as number | null) ?? null,
        closePrice: (r.close_price as number | null) ?? null,
        peRatio: (r.pe_ratio as number | null) ?? null,
        dividendYield: (r.dividend_yield as number | null) ?? null,
        freeFloat: (r.free_float as number | null) ?? null,
        volume30dAvg: (r.volume_30d_avg as number | null) ?? null,
      });
    }
    void sessionDate;
    return out;
  } catch {
    return [];
  }
}

// --------------------------------------------------------------- //
// Signal history (per session) for the walk-forward portfolio NAV. //
// --------------------------------------------------------------- //
export interface HistSignal {
  tradeDate: string;
  ticker: string;
  signalType: string;
  entryReference: number | null;
  stopLoss: number | null;
  conviction: string | null;
}

const ACTIONABLE = new Set([
  "ACCUMULATION",
  "STEALTH_ACCUMULATION",
  "INSTITUTIONAL_TARGET",
  "MOMENTUM_BREAKOUT",
  "INSIDER_BUYING",
  "LEVERAGE_FLUSH_BOTTOM",
  "VALUE_YIELD",
  "HIGH_YIELD",
]);

export async function fetchSignalHistory(
  sessions = 31
): Promise<HistSignal[]> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("signals_computed")
      .select(
        "trade_date,ticker,signal_type,entry_reference,stop_loss,metadata"
      )
      .order("trade_date", { ascending: false })
      .limit(6000);
    if (error) throw error;
    const rows = (data ?? []) as unknown as Record<string, unknown>[];
    const dates = Array.from(new Set(rows.map((r) => String(r.trade_date))))
      .sort()
      .reverse()
      .slice(0, sessions);
    const keep = new Set(dates);
    const out: HistSignal[] = [];
    for (const r of rows) {
      if (!keep.has(String(r.trade_date))) continue;
      const type = String(r.signal_type ?? "");
      if (!ACTIONABLE.has(type)) continue;
      const meta = (r.metadata ?? {}) as Record<string, unknown>;
      out.push({
        tradeDate: String(r.trade_date),
        ticker: String(r.ticker ?? "").toUpperCase(),
        signalType: type,
        entryReference: (r.entry_reference as number | null) ?? null,
        stopLoss: (r.stop_loss as number | null) ?? null,
        conviction:
          (meta.conviction as string | null | undefined) ?? null,
      });
    }
    return out;
  } catch {
    return [];
  }
}

// --------------------------------------------------------------- //
// Session signals for one ticker (inspection drawer).              //
// --------------------------------------------------------------- //
export interface DrawerSignal {
  tradeDate: string;
  ticker: string;
  timeframe: string;
  signalType: string;
  entryReference: number | null;
  stopLoss: number | null;
  rationale: string;
}

export async function fetchSignalsForTicker(
  sessionDate: string,
  ticker: string
): Promise<DrawerSignal[]> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("signals_computed")
      .select(
        "trade_date,ticker,timeframe,signal_type,entry_reference,stop_loss,rationale"
      )
      .eq("trade_date", sessionDate)
      .eq("ticker", ticker.toUpperCase())
      .limit(20);
    if (error) throw error;
    return ((data ?? []) as unknown as Record<string, unknown>[]).map((r) => ({
      tradeDate: String(r.trade_date),
      ticker: String(r.ticker),
      timeframe: String(r.timeframe),
      signalType: String(r.signal_type),
      entryReference: (r.entry_reference as number | null) ?? null,
      stopLoss: (r.stop_loss as number | null) ?? null,
      rationale: String(r.rationale ?? ""),
    }));
  } catch {
    return [];
  }
}

// --------------------------------------------------------------- //
// Recent OHLCV for one ticker (execution desk).                    //
// --------------------------------------------------------------- //
export interface OhlcvRow {
  tradeDate: string;
  open: number | null;
  high: number | null;
  low: number | null;
  close: number | null;
  volume: number | null;
}

export async function fetchTickerOhlcv(
  ticker: string,
  sessions = 5
): Promise<OhlcvRow[]> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("psx_daily_eod")
      .select(
        "trade_date,open_price,high_price,low_price,close_price,volume"
      )
      .eq("ticker", ticker.toUpperCase())
      .order("trade_date", { ascending: false })
      .limit(sessions);
    if (error) throw error;
    return ((data ?? []) as unknown as Record<string, unknown>[]).map((r) => ({
      tradeDate: String(r.trade_date),
      open: (r.open_price as number | null) ?? null,
      high: (r.high_price as number | null) ?? null,
      low: (r.low_price as number | null) ?? null,
      close: (r.close_price as number | null) ?? null,
      volume: (r.volume as number | null) ?? null,
    }));
  } catch {
    return [];
  }
}

// --------------------------------------------------------------- //
// EOD history for portfolio analytics + comparison desk.           //
// --------------------------------------------------------------- //
export interface EodPoint {
  ticker: string;
  tradeDate: string;
  close: number | null;
  volume: number | null;
}

export async function fetchEodHistory(
  sessionDate: string,
  sessions = 90
): Promise<EodPoint[]> {
  try {
    const supabase = getSupabase();
    const { data, error } = await supabase
      .from("psx_daily_eod")
      .select("trade_date,ticker,close_price,volume")
      .order("trade_date", { ascending: false })
      .limit(sessions * 600);
    if (error) throw error;
    const rows = (data ?? []) as unknown as {
      trade_date: string;
      ticker: string;
      close_price: number | null;
      volume: number | null;
    }[];
    // Keep only rows within the trailing N distinct sessions.
    const dates = Array.from(new Set(rows.map((r) => r.trade_date)))
      .sort()
      .reverse()
      .slice(0, sessions);
    const keep = new Set(dates);
    return rows
      .filter((r) => keep.has(r.trade_date))
      .map((r) => ({
        ticker: r.ticker,
        tradeDate: r.trade_date,
        close: r.close_price,
        volume: r.volume,
      }));
  } catch {
    return [];
  }
}
