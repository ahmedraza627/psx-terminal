"use client";

import { useEffect, useMemo, useRef, useState } from "react";

export type CommandAction =
  | { kind: "TAB"; tabId: string }
  | { kind: "COMPARE"; tickers: string[] }
  | { kind: "INSPECT"; ticker: string };

const DESK_COMMANDS: { cmd: string; label: string; tabId: string }[] = [
  { cmd: "WHALE", label: "Whale Matrix", tabId: "WHALE" },
  { cmd: "RESEARCH", label: "Research Desk", tabId: "RESEARCH" },
  { cmd: "ROTATION", label: "Sector Rotation", tabId: "ROTATION" },
  { cmd: "KIBOR", label: "KIBOR Easing Desk", tabId: "KIBOR" },
  { cmd: "LEDGER", label: "Insider Conviction Ledger", tabId: "LEDGER" },
  { cmd: "MOMENTUM", label: "Momentum Blotter", tabId: "MOMENTUM" },
  { cmd: "MTS", label: "MTS Squeeze Desk", tabId: "MTS" },
  { cmd: "NDM", label: "NDM Tape", tabId: "NDM" },
  { cmd: "EDGE", label: "Edge Lab", tabId: "EDGE" },
  { cmd: "RISK", label: "Risk Desk", tabId: "RISK" },
  { cmd: "PORTFOLIO", label: "Model Portfolio Desk", tabId: "PORTFOLIO" },
  { cmd: "WIRE", label: "Market Insights Wire", tabId: "WIRE" },
  { cmd: "NOTES", label: "Companies Explained", tabId: "NOTES" },
  { cmd: "WATCH", label: "Watchlists", tabId: "WATCH" },
];

/**
 * Bloomberg-style command bar (Cmd+K or `/`).
 * Grammar:  COMP <SYM> <SYM> [SYM]  -> comparison desk
 *           <DESK-VERB>             -> switch desk
 *           <TICKER>                -> inspection drawer
 */
export default function CommandBar({
  open,
  onClose,
  onAction,
  tickers,
}: {
  open: boolean;
  onClose: () => void;
  onAction: (a: CommandAction) => void;
  tickers: string[];
}) {
  const [text, setText] = useState("");
  const inputRef = useRef<HTMLInputElement>(null);

  useEffect(() => {
    if (open) {
      setText("");
      // Focus after paint so the slide-in doesn't swallow the click.
      const t = setTimeout(() => inputRef.current?.focus(), 30);
      return () => clearTimeout(t);
    }
  }, [open]);

  const suggestions = useMemo(() => {
    const raw = text.trim().toUpperCase();
    if (!raw) {
      return [
        { kind: "hint" as const, text: "COMP <SYM> <SYM> — head-to-head" },
        { kind: "hint" as const, text: "<TICKER> — inspect symbol" },
        ...DESK_COMMANDS.slice(0, 6).map((d) => ({
          kind: "desk" as const,
          text: d.cmd,
          label: d.label,
          tabId: d.tabId,
        })),
      ];
    }
    if (raw.startsWith("COMP ")) {
      const parts = raw.slice(5).split(/\s+/).filter(Boolean);
      return [
        {
          kind: "compare" as const,
          text: `COMP ${parts.join(" ")}`,
          label:
            parts.length >= 2
              ? `COMPARE ${parts.join(" · ")}`
              : "ADD A SECOND SYMBOL",
        },
      ];
    }
    const deskHits = DESK_COMMANDS.filter((d) => d.cmd.startsWith(raw));
    const tickerHits = tickers
      .filter((t) => t.startsWith(raw))
      .slice(0, 8)
      .map((t) => ({ kind: "ticker" as const, text: t, label: "INSPECT" }));
    return [
      ...deskHits.map((d) => ({
        kind: "desk" as const,
        text: d.cmd,
        label: d.label,
        tabId: d.tabId,
      })),
      ...tickerHits,
    ];
  }, [text, tickers]);

  const execute = () => {
    const raw = text.trim().toUpperCase();
    if (!raw) return;
    if (raw.startsWith("COMP ")) {
      const parts = raw.slice(5).split(/\s+/).filter(Boolean);
      if (parts.length >= 2) {
        onAction({ kind: "COMPARE", tickers: parts.slice(0, 3) });
        onClose();
      }
      return;
    }
    const desk = DESK_COMMANDS.find((d) => d.cmd === raw);
    if (desk) {
      onAction({ kind: "TAB", tabId: desk.tabId });
      onClose();
      return;
    }
    const ticker =
      tickers.find((t) => t === raw) ??
      tickers.find((t) => t.startsWith(raw)) ??
      raw;
    onAction({ kind: "INSPECT", ticker });
    onClose();
  };

  if (!open) return null;

  return (
    <div
      className="fixed inset-0 z-40 bg-obsidian/80"
      onClick={onClose}
      role="presentation"
    >
      <div
        className="mx-auto mt-16 w-[min(560px,92vw)] border border-hairline bg-panel"
        onClick={(e) => e.stopPropagation()}
        role="dialog"
        aria-label="Terminal command bar"
      >
        <div className="flex items-center gap-2 border-b border-hairline px-2.5 py-1.5">
          <span className="font-mono text-[10px] uppercase tracking-widest text-info">
            CMD
          </span>
          <input
            ref={inputRef}
            value={text}
            onChange={(e) => setText(e.target.value)}
            onKeyDown={(e) => {
              if (e.key === "Enter") execute();
              if (e.key === "Escape") onClose();
            }}
            placeholder="WHALE · COMP SYS NETSOL · <TICKER>"
            className="h-7 w-full bg-transparent font-mono text-xs uppercase tracking-wider text-ink placeholder:text-ghost focus:outline-none"
          />
          <span className="font-mono text-[9px] text-ghost">ESC</span>
        </div>
        <div className="max-h-64 overflow-y-auto scroll-thin">
          {suggestions.map((s, i) => (
            <button
              key={`${s.text}-${i}`}
              onClick={() => {
                if (s.kind === "hint") return;
                if (s.kind === "desk") {
                  onAction({ kind: "TAB", tabId: s.tabId });
                  onClose();
                } else if (s.kind === "ticker") {
                  onAction({ kind: "INSPECT", ticker: s.text });
                  onClose();
                } else if (s.kind === "compare") {
                  setText(s.text);
                }
              }}
              className="flex w-full items-center justify-between border-b border-hairline px-2.5 py-1.5 text-left hover:bg-hoverline"
            >
              <span className="font-mono text-[11px] text-ink">{s.text}</span>
              <span className="font-mono text-[9px] uppercase tracking-widest text-ghost">
                {"label" in s ? s.label : ""}
              </span>
            </button>
          ))}
        </div>
      </div>
    </div>
  );
}
</file>

<file path="frontend/components/FeatureRequestPortal.tsx">
"use client";

import { useEffect, useMemo, useState } from "react";
import { Badge } from "@/components/ui/primitives";

/**
 * In-app feature request & upvote portal. Requests persist in localStorage
 * (single-desk install; a Supabase table swaps in with zero component
 * changes when multi-user is enabled). Seeded engineering items document the
 * roadmap so users can upvote real bottlenecks from day one.
 */
interface RequestItem {
  id: string;
  title: string;
  detail: string;
  category: "DESK" | "DATA" | "ALPHA" | "EXECUTION" | "UX";
  votes: number;
  createdAt: string;
  seeded: boolean;
}

const LS_KEY = "psx-terminal-feature-requests-v1";

const SEEDS: Omit<RequestItem, "id" | "createdAt" | "seeded">[] = [
  {
    title: "Live intraday feed (sub-minute polling)",
    detail:
      "Current terminal is EOD-bound by the pipeline cadence. Intraday NDM/flow polling would enable reaction desks.",
    category: "DATA",
    votes: 9,
  },
  {
    title: "Broker-code level flow attribution feed",
    detail:
      "PSX publishes broker-wise clearing data on paid feeds only — wiring it would unlock cluster accumulation detection.",
    category: "DATA",
    votes: 7,
  },
  {
    title: "Walk-forward automation for new alpha engines",
    detail:
      "Every new engine should auto-enter the 30-session edge evaluation instead of manual reseeding.",
    category: "ALPHA",
    votes: 5,
  },
];

function loadItems(): RequestItem[] {
  const seeds: RequestItem[] = SEEDS.map((s, i) => ({
    ...s,
    id: `seed-${i}`,
    createdAt: "2026-09-01",
    seeded: true,
  }));
  try {
    const raw = window.localStorage.getItem(LS_KEY);
    if (raw) {
      const userItems = JSON.parse(raw) as RequestItem[];
      return [...userItems, ...seeds];
    }
  } catch {
    /* fall through to seeds */
  }
  return seeds;
}

function persistUserItems(items: RequestItem[]) {
  try {
    window.localStorage.setItem(
      LS_KEY,
      JSON.stringify(items.filter((i) => !i.seeded))
    );
  } catch {
    /* storage unavailable — session-local */
  }
}

export default function FeatureRequestPortal({
  open,
  onClose,
}: {
  open: boolean;
  onClose: () => void;
}) {
  const [items, setItems] = useState<RequestItem[]>([]);
  const [title, setTitle] = useState("");
  const [detail, setDetail] = useState("");
  const [category, setCategory] = useState<RequestItem["category"]>("DESK");
  const [hydrated, setHydrated] = useState(false);

  useEffect(() => {
    if (open) {
      setItems(loadItems());
      setHydrated(true);
    }
  }, [open]);

  const sorted = useMemo(
    () => items.slice().sort((a, b) => b.votes - a.votes),
    [items]
  );

  if (!open) return null;

  const submit = () => {
    if (!title.trim()) return;
    const item: RequestItem = {
      id: `req-${Date.now()}`,
      title: title.trim(),
      detail: detail.trim(),
      category,
      votes: 1,
      createdAt: new Date().toISOString().slice(0, 10),
      seeded: false,
    };
    const next = [item, ...items];
    setItems(next);
    persistUserItems(next);
    setTitle("");
    setDetail("");
  };

  const upvote = (id: string) => {
    const next = items.map((i) =>
      i.id === id ? { ...i, votes: i.votes + 1 } : i
    );
    setItems(next);
    persistUserItems(next);
  };

  return (
    <div
      className="fixed inset-0 z-40 bg-obsidian/80"
      onClick={onClose}
      role="presentation"
    >
      <div
        className="mx-auto mt-10 w-[min(640px,94vw)] border border-hairline bg-panel"
        onClick={(e) => e.stopPropagation()}
        role="dialog"
        aria-label="Feature request portal"
      >
        <div className="flex items-center justify-between border-b border-hairline px-2.5 py-1.5">
          <h2 className="font-mono text-[10px] font-medium uppercase tracking-widest text-muted">
            Engineering Portal — Request & Upvote
          </h2>
          <button
            onClick={onClose}
            className="font-mono text-[10px] text-muted hover:text-ink"
          >
            ESC
          </button>
        </div>

        {/* New request */}
        <div className="border-b border-hairline px-2.5 py-2">
          <input
            value={title}
            onChange={(e) => setTitle(e.target.value)}
            placeholder="DESK / BOTTLENECK TITLE…"
            className="h-7 w-full rounded-[2px] border border-hairline bg-obsidian px-2 font-mono text-[11px] uppercase tracking-wider text-ink placeholder:text-ghost focus:border-info/50 focus:outline-none"
            aria-label="Request title"
          />
          <textarea
            value={detail}
            onChange={(e) => setDetail(e.target.value)}
            placeholder="WORKFLOW GAP — WHAT WOULD THIS UNLOCK FOR THE DESK?"
            rows={2}
            className="mt-1.5 w-full rounded-[2px] border border-hairline bg-obsidian px-2 py-1.5 font-mono text-[11px] text-ink placeholder:text-ghost focus:border-info/50 focus:outline-none"
            aria-label="Request detail"
          />
          <div className="mt-1.5 flex items-center gap-1">
            {(["DESK", "DATA", "ALPHA", "EXECUTION", "UX"] as const).map((c) => (
              <button
                key={c}
                onClick={() => setCategory(c)}
                className={`rounded-[2px] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider ring-1 ${
                  c === category
                    ? "bg-info/10 text-info ring-info/30"
                    : "bg-panel text-muted ring-hairline hover:text-ink"
                }`}
              >
                {c}
              </button>
            ))}
            <button
              onClick={submit}
              className="ml-auto rounded-[2px] bg-bull/10 px-2 py-0.5 font-mono text-[10px] font-semibold uppercase tracking-wider text-bull ring-1 ring-bull/30 hover:bg-bull/20"
            >
              SUBMIT REQUEST
            </button>
          </div>
        </div>

        {/* List */}
        {!hydrated ? null : (
          <ol className="max-h-80 overflow-y-auto scroll-thin">
            {sorted.map((it) => (
              <li
                key={it.id}
                className="flex items-start gap-2 border-b border-hairline px-2.5 py-1.5 hover:bg-hoverline"
              >
                <button
                  onClick={() => upvote(it.id)}
                  className="flex w-10 shrink-0 flex-col items-center rounded-[2px] py-0.5 ring-1 ring-hairline hover:ring-info/40"
                  aria-label={`Upvote ${it.title}`}
                >
                  <span className="text-[10px] leading-none text-ghost">▲</span>
                  <span className="font-mono text-[11px] tabular-nums text-info">
                    {it.votes}
                  </span>
                </button>
                <div className="min-w-0">
                  <div className="flex items-center gap-1.5">
                    <span className="font-mono text-[11px] font-semibold text-ink">
                      {it.title}
                    </span>
                    <Badge tone="neutral">{it.category}</Badge>
                    {it.seeded && <Badge tone="ghost">ROADMAP</Badge>}
                  </div>
                  {it.detail && (
                    <p className="mt-0.5 text-[11px] leading-snug text-muted">
                      {it.detail}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        )}
      </div>
    </div>
  );
}
</file>

<file path="frontend/components/MarketInsightsDesk.tsx">
"use client";

import { useMemo } from "react";
import { Badge, DeskFrame, IdleState } from "@/components/ui/primitives";
import { fmtPct, fmtPkrB, fmtPkrM } from "@/components/ui/format";
import type {
  Barometer,
  DisclosureRow,
  KiborRow,
  MtsRow,
  RolloverRow,
  RotationRow,
  WhaleRow,
} from "@/lib/queries";

/**
 * Terminal wire: every item is DERIVED from stored, real data — NCCPL flows,
 * MTS leverage prints, futures basis inversions, insider filings, RRG
 * regimes and rate-sensitivity screens. No scraped headlines, no synthetic
 * news: PSX/SBP textual disclosures are not licensed to us, so the wire
 * speaks only in quant events the database actually contains.
 */
export interface WireItem {
  id: string;
  timeTag: string;
  impact: "BULLISH" | "BEARISH" | "NEUTRAL";
  headline: string;
  tickers: string[];
  sectors: string[];
  /** EPS sensitivity context when the item has rate/earnings math behind it. */
  sensitivity?: string;
  source: string;
}

interface Props {
  barometer: Barometer | null;
  whaleRows: WhaleRow[];
  mtsRows: MtsRow[];
  rolloverRows: RolloverRow[];
  disclosures: DisclosureRow[];
  rotation: RotationRow[];
  kibor: KiborRow[];
}

export default function MarketInsightsDesk({
  barometer,
  whaleRows,
  mtsRows,
  rolloverRows,
  disclosures,
  rotation,
  kibor,
}: Props) {
  const items = useMemo<WireItem[]>(() => {
    const out: WireItem[] = [];

    if (barometer) {
      const bull = barometer.institutionalNet > 0;
      out.push({
        id: "flows",
        timeTag: barometer.tradeDate,
        impact:
          barometer.institutionalNet === 0
            ? "NEUTRAL"
            : bull
              ? "BULLISH"
              : "BEARISH",
        headline: `NCCPL institutions net ${fmtPkrB(barometer.institutionalNet)} · retail ${fmtPkrB(barometer.retailNet)} — ${
          barometer.divergence === "SMART_MONEY_ACCUMULATION"
            ? "smart money accumulating against retail supply"
            : barometer.divergence === "RETAIL_TRAP_RISK"
              ? "retail buying into institutional distribution"
              : "flows aligned"
        }`,
        tickers: [],
        sectors: [],
        source: "nccpl_fipi_lipi",
      });
    }

    for (const w of whaleRows.slice(0, 6)) {
      out.push({
        id: `whale-${w.ticker}`,
        timeTag: w.trade_date,
        impact: "BULLISH",
        headline: `${w.meta.conviction ?? "MODERATE"}-conviction stealth accumulation · vol ${w.meta.vol_multiple?.toFixed(1) ?? "—"}× SMA20${w.meta.ndm_confirmed ? " · NDM-confirmed off-market prints" : ""}`,
        tickers: [w.ticker],
        sectors: w.meta.sector ? [w.meta.sector] : [],
        source: "signals_computed/WHALE_RADAR",
      });
    }

    for (const m of mtsRows.slice(0, 6)) {
      out.push({
        id: `mts-${m.ticker}`,
        timeTag: m.tradeDate,
        impact: "BEARISH",
        headline: `MTS leverage ${m.utilizationPct != null ? `${m.utilizationPct.toFixed(0)}% of cap` : "print"} on ${m.ticker} — value ${fmtPkrB(m.mtsValuePkr)}${m.valueDropPct != null ? ` · ${fmtPct(m.valueDropPct, 1)} unwind` : ""}: liquidation-cascade risk elevated`,
        tickers: [m.ticker],
        sectors: [],
        source: "nccpl_mts_leverage",
      });
    }

    for (const r of rolloverRows.slice(0, 5)) {
      out.push({
        id: `roll-${r.ticker}`,
        timeTag: r.tradeDate,
        impact: r.stance === "SHORT_BIAS" ? "BEARISH" : "NEUTRAL",
        headline: `Futures basis ${r.basisPct?.toFixed(2) ?? "—"}% on ${r.futuresSymbol ?? r.ticker}${r.basisPrevPct != null ? ` (prev ${r.basisPrevPct.toFixed(2)}%)` : ""} — ${r.stance === "SHORT_BIAS" ? "basis inversion: delivery pressure" : "rollover flow normal"}`,
        tickers: [r.ticker],
        sectors: [],
        source: "signals_computed/ROLLOVER_DESK",
      });
    }

    const ultra = disclosures.filter(
      (d) => d.conviction === "ULTRA_HIGH" && d.tradeType === "BUY"
    );
    for (const d of ultra.slice(0, 5)) {
      out.push({
        id: `disc-${d.ticker}-${d.insiderName}`,
        timeTag: d.tradeDate,
        impact: "BULLISH",
        headline: `${d.designation} ${d.insiderName} bought ${fmtPkrB(d.notionalPkr)} of ${d.ticker} — ULTRA_HIGH conviction filing`,
        tickers: [d.ticker],
        sectors: [],
        sensitivity: "Insider buys ≥ 10M PKR by sponsors/directors historically front-run re-ratings",
        source: "psx_insider_disclosures",
      });
    }

    const leading = rotation.filter((r) => r.quadrant === "LEADING").slice(0, 4);
    if (leading.length > 0) {
      out.push({
        id: "rrg",
        timeTag: leading[0].tradeDate,
        impact: "BULLISH",
        headline: `RRG leadership: ${leading.map((r) => r.sectorName).join(", ")} holding LEADING vs KSE-100`,
        tickers: leading
          .map((r) => r.topLeaderTicker)
          .filter((t): t is string => t != null),
        sectors: leading.map((r) => r.sectorName),
        source: "psx_sector_rotation",
      });
    }

    const topKibor = kibor.slice(0, 3);
    if (topKibor.length > 0) {
      out.push({
        id: "kibor",
        timeTag: topKibor[0].tradeDate,
        impact: "BULLISH",
        headline: `Rate-cut leverage screen: ${topKibor.map((k) => k.ticker).join(" · ")} lead EPS expansion on a 300bps easing cycle`,
        tickers: topKibor.map((k) => k.ticker),
        sectors: topKibor
          .map((k) => k.sectorName)
          .filter((s): s is string => s != null),
        sensitivity: `ΔEPS/100bps: ${topKibor
          .map((k) => `${k.ticker} ${k.epsImpact100bpsPkr != null ? fmtPkrM(k.epsImpact100bpsPkr * 1e6, 2) : "—"}`)
          .join(" · ")}`,
        source: "psx_kibor_sensitivity",
      });
    }

    return out;
  }, [barometer, whaleRows, mtsRows, rolloverRows, disclosures, rotation, kibor]);

  return (
    <DeskFrame
      title="Market Insights — EPS Impact Wire"
      right={
        <span className="font-mono text-[10px] uppercase tracking-widest text-ghost">
          {items.length} ITEMS · QUANT-EVENT FEED
        </span>
      }
      footer={
        <p className="font-mono text-[10px] leading-relaxed text-ghost">
          The wire publishes only events present in the terminal&apos;s own
          tables (flows, leverage, basis, filings, regimes, rate screens).
          Textual PSX/SBP releases are not ingested — nothing here is
          paraphrased or synthesized.
        </p>
      }
    >
      {items.length === 0 ? (
        <IdleState
          headline="[WIRE: NO QUANT EVENTS STORED YET]"
          detail="Items appear as pipeline passes populate flows, leverage, filings and rotation tables."
        />
      ) : (
        <ol>
          {items.map((it) => (
            <li
              key={it.id}
              className="wire-in border-b border-hairline px-2.5 py-1.5 hover:bg-hoverline"
            >
              <div className="flex items-center gap-2">
                <Badge
                  tone={
                    it.impact === "BULLISH"
                      ? "bull"
                      : it.impact === "BEARISH"
                        ? "bear"
                        : "neutral"
                  }
                >
                  {it.impact}
                </Badge>
                <span className="font-mono text-[10px] tabular-nums text-ghost">
                  {it.timeTag}
                </span>
                <span className="ml-auto font-mono text-[9px] uppercase tracking-widest text-ghost">
                  {it.source}
                </span>
              </div>
              <p className="mt-0.5 text-[12px] leading-snug text-ink">
                {it.headline}
              </p>
              {(it.tickers.length > 0 || it.sectors.length > 0) && (
                <p className="mt-0.5 font-mono text-[10px] uppercase tracking-wider text-muted">
                  {it.sectors.length > 0 && `SECTORS: ${it.sectors.join(", ")} `}
                  {it.tickers.length > 0 && `· TICKERS: ${it.tickers.join(" ")}`}
                </p>
              )}
              {it.sensitivity && (
                <p className="mt-0.5 font-mono text-[10px] text-warn">
                  {it.sensitivity}
                </p>
              )}
            </li>
          ))}
        </ol>
      )}
    </DeskFrame>
  );
}
</file>

<file path="frontend/components/ModelPortfolioDesk.tsx">
"use client";

import { useMemo, useState } from "react";
import { DataTable, DeskFrame, IdleState, Row } from "@/components/ui/primitives";
import { fmtInt, fmtPct, fmtPrice, tonePct } from "@/components/ui/format";
import { sizeBook, RISK_DEFAULTS, type SizingSignal } from "@/lib/risk";
import {
  buildPortfolioNav,
  computeExposure,
  navSvg,
} from "@/lib/portfolio";
import type { EodPoint, HistSignal } from "@/lib/deskQueries";

const EQUITY_DEFAULT = 5_000_000;

interface Props {
  /** Active-session signals (drives the live holdings ledger). */
  sizingSignals: SizingSignal[];
  /** Trailing-session signals for the walk-forward NAV. */
  historySignals: HistSignal[];
  eod: EodPoint[];
  sectorMap: Map<string, string>;
  marketCapByTicker: Map<string, number>;
}

export default function ModelPortfolioDesk({
  sizingSignals,
  historySignals,
  eod,
  sectorMap,
  marketCapByTicker,
}: Props) {
  const [equity, setEquity] = useState(EQUITY_DEFAULT);

  // Active session book (risk-engine conventions).
  const book = useMemo(
    () => sizeBook(sizingSignals, equity, RISK_DEFAULTS),
    [sizingSignals, equity]
  );

  // Walk-forward NAV over stored history (no look-ahead: each session's
  // actionable signals are marked with the NEXT session's stored closes).
  const signalsByDate = useMemo(() => {
    const m = new Map<string, SizingSignal[]>();
    for (const h of historySignals) {
      const list = m.get(h.tradeDate) ?? [];
      list.push({
        ticker: h.ticker,
        signalType: h.signalType,
        entryReference: h.entryReference,
        stopLoss: h.stopLoss,
        conviction: h.conviction,
      });
      m.set(h.tradeDate, list);
    }
    return m;
  }, [historySignals]);

  const { nav, stats } = useMemo(
    () => buildPortfolioNav(signalsByDate, eod, 30),
    [signalsByDate, eod]
  );

  const exposure = useMemo(
    () =>
      computeExposure(
        book.positions.map((p) => ({
          positionValuePkr: p.positionValuePkr,
          ticker: p.ticker,
        })),
        sectorMap,
        marketCapByTicker
      ),
    [book.positions, sectorMap, marketCapByTicker]
  );

  const curve = navSvg(nav);
  const maxDelta = Math.max(
    1e-9,
    ...exposure.map((e) => Math.abs(e.deltaPct))
  );

  const lastCloseBy = useMemo(() => {
    // Latest stored close per ticker for ledger marks.
    const m = new Map<string, number>();
    for (const r of eod) {
      const t = r.ticker.toUpperCase();
      if (!m.has(t) && r.close != null) m.set(t, r.close);
    }
    return m;
  }, [eod]);

  if (historySignals.length === 0 && eod.length === 0) {
    return (
      <DeskFrame title="Model Portfolio vs Market">
        <IdleState
          tone="warn"
          headline="[PORTFOLIO DESK: INSUFFICIENT STORED HISTORY]"
          detail="The NAV walk needs trailing signals + EOD history (psx_daily_eod, signals_computed). Run the pipeline passes to populate."
        />
      </DeskFrame>
    );
  }

  return (
    <>
      <DeskFrame
        title="Model Portfolio — NAV vs Equal-Weight Market Proxy"
        right={
          <div className="flex items-center gap-1.5">
            <span className="font-mono text-[9px] uppercase tracking-widest text-ghost">
              EQUITY PKR
            </span>
            <input
              type="number"
              value={equity}
              min={100000}
              step={500000}
              onChange={(e) =>
                setEquity(Math.max(100000, Number(e.target.value) || 0))
              }
              className="h-5 w-28 rounded-[2px] border border-hairline bg-obsidian px-1.5 font-mono text-[11px] tabular-nums text-ink focus:border-info/50 focus:outline-none"
              aria-label="Portfolio equity PKR"
            />
          </div>
        }
        footer={
          <p className="font-mono text-[10px] leading-relaxed text-ghost">
            Walk-forward book: each stored session&apos;s actionable signals,
            equal-weight, marked at the next session&apos;s closes (no
            look-ahead). Benchmark is an equal-weight market proxy built from
            all stored closes — PSX publishes no free index series in our
            tables. Alpha = Jensen&apos;s (rf = 11% 6M-KIBOR stand-in) · Sharpe
            = (mean − rf) / σ, annualized √252.
          </p>
        }
      >
        {/* Stat strip */}
        <div className="grid grid-cols-3 gap-px border-b border-hairline bg-hairline sm:grid-cols-6">
          {[
            { k: "BOOK NAV", v: fmtPct(stats.bookTotalPct, 1), t: tonePct(stats.bookTotalPct) },
            { k: "PROXY NAV", v: fmtPct(stats.proxyTotalPct, 1), t: tonePct(stats.proxyTotalPct) },
            { k: "ALPHA ANN", v: fmtPct(stats.alphaAnnPct, 1), t: tonePct(stats.alphaAnnPct) },
            { k: "BETA", v: stats.beta != null ? stats.beta.toFixed(2) : "—", t: "text-ink" },
