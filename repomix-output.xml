            </span>
            <span className="font-mono text-[9px] uppercase tracking-widest text-info">
              -- MARKET PROXY
            </span>
            <span className="ml-auto font-mono text-[9px] tabular-nums text-ghost">
              {stats.sessions} SESSIONS
            </span>
          </div>
