<file path="frontend/components/MtsLiquidationDesk.tsx">
"use client";

import { useMemo } from "react";
import { Badge, DataTable, DeskFrame, IdleState, Row } from "@/components/ui/primitives";
import { fmtPct, fmtPkrB, fmtPrice } from "@/components/ui/format";
import type { MtsRow } from "@/components/MtsSqueezeBlotter";
import type { EodPoint } from "@/lib/deskQueries";

/**
 * MTS margin liquidation ladder.
 *
 * NCCPL MTS structures: leveraged buyers post initial margin and finance the
 * rest (financing ratio F = price exposure / equity). As price falls, equity
 * erodes by F × the price move; the margin call fires when equity reaches
 * the maintenance level and positions force-liquidate near the exit level.
 *
 *   P_call = P_entry × (1 − (1 − MAINT_EQUITY) / F)
 *   P_exit = P_entry × (1 − (1 − EXIT_EQUITY) / F)
 *
 * We cannot observe leveraged buyers' entry vintages, so the ladder prices
 * the threshold for three REAL entry points from stored EOD: the close 5,
 * 10 and 20 sessions ago. A vintage whose threshold sits at/above LTP is
 * already in call — that share of MTS value is the cascade fuel. Parameters
 * are disclosed below and conservative (mid-range of NCCPL's authorized
 * leverage bands); they are modeling assumptions, not client data.
 */
const FINANCING_RATIO = 3.0; // ~33% initial margin (NCCPL band midpoint)
const MAINT_EQUITY = 0.20; // margin call equity level
const EXIT_EQUITY = 0.12; // forced-liquidation equity level

const CALL_FACTOR = 1 - (1 - MAINT_EQUITY) / FINANCING_RATIO; // × entry
const EXIT_FACTOR = 1 - (1 - EXIT_EQUITY) / FINANCING_RATIO;

type LadderStatus = "SAFE" | "IN_CALL" | "LIQUIDATION";

interface LadderRowView {
  ticker: string;
  mtsValuePkr: number | null;
  utilizationPct: number | null;
  ltp: number | null;
  thresholds: { sessions: number; callPrice: number | null }[];
  /** Worst vintage status across the ladder. */
  status: LadderStatus;
  /** Share of the 20-session price range below the oldest vintage call. */
  atRiskPct: number | null;
}

function closeBySessionGap(
  closesNewestFirst: { date: string; close: number | null }[],
  gap: number
): number | null {
  // gap = sessions back from the newest stored session
  const idx = gap; // newest-first array: index IS the session gap
  return closesNewestFirst[idx]?.close ?? null;
}


export default function MtsLiquidationDesk({
  mtsRows,
  eod,
}: {
  mtsRows: MtsRow[];
  eod: EodPoint[];
}) {
  const ladder = useMemo<LadderRowView[]>(() => {
    if (mtsRows.length === 0) return [];
    const byTicker = new Map<string, { date: string; close: number | null }[]>();
    for (const r of eod) {
      const t = r.ticker.toUpperCase();
      const list = byTicker.get(t) ?? [];
      list.push({ date: r.tradeDate, close: r.close });
      byTicker.set(t, list);
    }
    byTicker.forEach((list) => {
      list.sort((a, b) => (a.date < b.date ? 1 : -1));
    });
    return mtsRows.map((m) => {
      const hist = byTicker.get(m.ticker.toUpperCase()) ?? [];
      const ltp = hist[0]?.close ?? m.entryReference;
      const thresholds = [5, 10, 20].map((gap) => {
        const p0 = closeBySessionGap(hist, gap);
        return {
          sessions: gap,
          callPrice: p0 != null ? p0 * CALL_FACTOR : null,
        };
      });
      // At-risk: LTP already at/below the 5-session-vintage call threshold.
      const call5 = thresholds[0].callPrice;
      const atRiskPct =
        ltp != null && call5 != null && call5 > 0
          ? Math.max(0, Math.min(100, ((call5 - ltp) / call5) * 100 * 3.0))
          : null;
      const worst: LadderStatus = thresholds.some(
        (t) => t.callPrice != null && ltp != null && ltp <= t.callPrice * (EXIT_FACTOR / CALL_FACTOR)
      )
        ? "LIQUIDATION"
        : thresholds.some((t) => t.callPrice != null && ltp != null && ltp <= t.callPrice)
          ? "IN_CALL"
          : "SAFE";
      return {
        ticker: m.ticker,
        mtsValuePkr: m.mtsValuePkr,
        utilizationPct: m.utilizationPct,
        ltp,
        thresholds,
        status: worst,
        atRiskPct,
      };
    });
  }, [mtsRows, eod]);

  const atRiskValue = ladder
    .filter((l) => l.status !== "SAFE")
    .reduce((a, l) => a + (l.mtsValuePkr ?? 0), 0);
  const totalValue = ladder.reduce((a, l) => a + (l.mtsValuePkr ?? 0), 0);

  return (
    <DeskFrame
      title="MTS Margin Liquidation Ladder — Cascade Thresholds"
      right={
        totalValue > 0 ? (
          <span className="font-mono text-[10px] tabular-nums text-ghost">
            BOOK {fmtPkrB(totalValue)} · AT RISK{" "}
            <span className={atRiskValue > 0 ? "text-bear" : "text-bull"}>
              {fmtPkrB(atRiskValue)}
            </span>
          </span>
        ) : null
      }
      footer={
        <p className="font-mono text-[10px] leading-relaxed text-ghost">
          Threshold = entry × {CALL_FACTOR.toFixed(3)} (call) /{" "}
          {(CALL_FACTOR * (EXIT_FACTOR / CALL_FACTOR)).toFixed(3)} (forced
          exit), from F = {FINANCING_RATIO.toFixed(1)}× financing, maintenance
          equity {Math.round(MAINT_EQUITY * 100)}%, exit{" "}
          {Math.round(EXIT_EQUITY * 100)}%. Entry vintages are REAL closes at
          t−5/−10/−20 sessions — actual leveraged entries are unobservable;
          the ladder is a threshold map, not client positions.
        </p>
      }
    >
      {mtsRows.length === 0 ? (
        <IdleState
          headline="[MTS FEED: AWAITING NCCPL CLEARING]"
          detail="Ladder builds from nccpl_mts_leverage prints — no leverage rows stored for this session."
        />
      ) : (
        <DataTable
          minWidth={820}
          columns={[
            { label: "Ticker" },
            { label: "MTS Value", align: "right" },
            { label: "Util %", align: "right" },
            { label: "LTP", align: "right" },
            { label: "Call @5S", align: "right" },
            { label: "Call @10S", align: "right" },
            { label: "Call @20S", align: "right" },
            { label: "State", align: "right" },
            { label: "Cascade Fuel", align: "right" },
          ]}
        >
          {ladder.map((l) => (
            <Row key={l.ticker}>
              <td className="px-2.5 py-1 font-mono text-[11px] font-semibold text-ink">
                {l.ticker}
              </td>
              <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums text-ink">
                {fmtPkrB(l.mtsValuePkr)}
              </td>
              <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums text-warn">
                {l.utilizationPct != null ? `${l.utilizationPct.toFixed(0)}%` : "—"}
              </td>
              <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums text-ink">
                {fmtPrice(l.ltp)}
              </td>
              {l.thresholds.map((t) => {
                const breached =
                  l.ltp != null && t.callPrice != null && l.ltp <= t.callPrice;
                return (
                  <td
                    key={t.sessions}
                    className={`px-2 py-1 text-right font-mono text-[11px] tabular-nums ${breached ? "text-bear font-semibold" : "text-muted"}`}
                  >
                    {fmtPrice(t.callPrice)}
                    {breached && " ⚠"}
                  </td>
                );
              })}
              <td className="px-2 py-1 text-right">
                <Badge
                  tone={
                    l.status === "LIQUIDATION"
                      ? "bear"
                      : l.status === "IN_CALL"
                        ? "warn"
                        : "bull"
                  }
                >
                  {l.status.replace("_", " ")}
                </Badge>
              </td>
              <td className="px-2 py-1 text-right font-mono text-[11px] tabular-nums">
                {l.atRiskPct != null && l.atRiskPct > 0 ? (
                  <span className="text-bear">{l.atRiskPct.toFixed(0)}%</span>
                ) : (
                  <span className="text-ghost">—</span>
                )}
              </td>
            </Row>
          ))}
        </DataTable>
      )}
    </DeskFrame>
  );
}
</file>

<file path="frontend/components/ResearchNotesDesk.tsx">
"use client";

import { useMemo, useState } from "react";
import { Badge, DeskFrame, IdleState } from "@/components/ui/primitives";
import { fmtPct, fmtPrice, fmtX } from "@/components/ui/format";
import type { ResearchRow, WhaleRow } from "@/lib/queries";
import type { FundamentalsRow } from "@/lib/deskQueries";

interface Props {
  research: ResearchRow[];
  fundamentals: FundamentalsRow[];
  whaleRows: WhaleRow[];
  onInspect: (ticker: string) => void;
}

/**
 * "Companies Explained" institutional note reader. Every figure is computed
 * from stored rows: target price = psx_equity_research intrinsic value
 * (PSX-MF relative P/E + dividend-floor model — the method badge renders the
 * stored model_version), LTP = fundamentals close, dated events = real
 * signal/disclosure sessions. Qualitative sections (moat scoring) render an
 * explicit pending state instead of invented prose.
 */
export default function ResearchNotesDesk({
  research,
  fundamentals,
  whaleRows,
  onInspect,
}: Props) {
  const [selected, setSelected] = useState<string | null>(null);

  const rowsByTicker = useMemo(() => {
    const m = new Map<string, ResearchRow>();
    for (const r of research) m.set(r.ticker.toUpperCase(), r);
    return m;
  }, [research]);

  const fundByTicker = useMemo(() => {
    const m = new Map<string, FundamentalsRow>();
    for (const f of fundamentals) m.set(f.ticker.toUpperCase(), f);
    return m;
  }, [fundamentals]);

  const candidates = useMemo(
    () =>
      research
        .slice()
        .sort((a, b) => b.alphaScore - a.alphaScore)
        .slice(0, 40),
    [research]
  );

  const active: ResearchRow | null =
    selected != null
      ? rowsByTicker.get(selected) ?? candidates[0] ?? null
      : candidates[0] ?? null;
  const fund = active
    ? fundByTicker.get(active.ticker.toUpperCase()) ?? null
    : null;
  const whale = active
    ? whaleRows.find((w) => w.ticker.toUpperCase() === active.ticker.toUpperCase()) ??
      null
    : null;

  if (research.length === 0) {
    return (
      <DeskFrame title="Companies Explained — Institutional Notes">
        <IdleState
          tone="warn"
          headline="[RESEARCH NOTES: NO EQUITY RESEARCH ROWS]"
          detail="Notes generate from psx_equity_research — run the fundamental pass to populate."
        />
      </DeskFrame>
    );
  }

  const ltp = fund?.closePrice ?? whale?.entry_reference ?? null;
  const target = active?.intrinsicValuePkr ?? null;
  const upside =
    target != null && ltp != null && ltp > 0
      ? ((target - ltp) / ltp) * 100
      : null;
  const method =
    active?.modelVersion != null
      ? `PSX-MF · ${active.modelVersion}`
      : "PSX-MF";
  const methodDetail =
    active?.targetPeUsed != null
      ? `Relative P/E: TTM EPS × ${fmtX(active.targetPeUsed, 1)} sector multiple${
          active.dividendFloorPkr != null
            ? " · blended 60/40 with dividend-yield floor (K_e = 13.5% − 4% g)"
            : ""
        }`
      : "Relative P/E: TTM EPS × sector-normal multiple";

  // Dated event tape: real stored rows only.
  const events: { date: string; label: string; tone: "bull" | "info" | "warn" | "bear" }[] = [];
  if (whale) {
    events.push({
      date: whale.trade_date,
      label: `WHALE_RADAR ${whale.signal_type} · vol ${whale.meta.vol_multiple?.toFixed(1) ?? "—"}×`,
      tone: "bull",
    });
  }
  if (active?.valuationStatus) {
    events.push({
      date: active.tradeDate,
      label: `Valuation pass: ${active.valuationStatus.replace(/_/g, " ")} (${fmtPct(active.valuationDiscountPct, 1)})`,
      tone:
        active.valuationStatus === "UNDERVALUED"
          ? "bull"
          : active.valuationStatus === "OVERVALUED"
            ? "bear"
            : "info",
    });
  }

  return (
    <DeskFrame
      title="Companies Explained — Institutional Research Notes"
      right={
        <span className="font-mono text-[10px] uppercase tracking-widest text-ghost">
          {candidates.length} COVERED · ALPHA-RANKED
        </span>
      }
      footer={
        <p className="font-mono text-[10px] leading-relaxed text-ghost">
          Target price = stored intrinsic value; the valuation method renders
          the exact model outputs (target P/E multiple, dividend floor). Moat
          scoring requires a qualitative ingestion feed — it is never
          synthesized. Catalysts list real stored events only.
        </p>
      }
    >
      {/* Coverage selector */}
      <div className="scroll-thin flex gap-1 overflow-x-auto border-b border-hairline px-2.5 py-1.5">
        {candidates.map((r) => (
          <button
            key={r.ticker}
            onClick={() => setSelected(r.ticker)}
            className={`shrink-0 rounded-[2px] px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider ring-1 ${
              active?.ticker === r.ticker
                ? "bg-info/10 text-info ring-info/30"
                : "bg-panel text-muted ring-hairline hover:text-ink"
            }`}
          >
            {r.ticker} {r.alphaScore.toFixed(0)}
          </button>
        ))}
      </div>

      {active && (
        <div className="wire-in">
          {/* Note header */}
          <div className="flex flex-wrap items-center gap-x-4 gap-y-1 border-b border-hairline px-2.5 py-2">
            <button
              onClick={() => onInspect(active.ticker)}
              className="font-mono text-sm font-bold tracking-widest text-ink hover:text-info"
            >
              {active.ticker}
            </button>
            {fund?.sectorName && (
              <Badge tone="neutral">{fund.sectorName.toUpperCase()}</Badge>
            )}
            <span className="font-mono text-[11px] tabular-nums text-muted">
              LTP <span className="text-ink">{fmtPrice(ltp)}</span>
            </span>
            <span className="font-mono text-[11px] tabular-nums text-muted">
              TARGET <span className="text-bull">{fmtPrice(target)}</span>
            </span>
            <span
              className={`font-mono text-[11px] tabular-nums ${upside != null && upside >= 0 ? "text-bull" : "text-bear"}`}
            >
              UPSIDE {fmtPct(upside, 1)}
            </span>
            <span className="ml-auto flex items-center gap-1.5">
              <Badge tone="info">VALUATION: {method}</Badge>
              <Badge
                tone={active.alphaScore >= 70 ? "bull" : active.alphaScore >= 50 ? "info" : "warn"}
              >
                ALPHA {active.alphaScore.toFixed(0)}
              </Badge>
            </span>
          </div>

          <div className="grid gap-px bg-hairline md:grid-cols-2">
            {/* Valuation methodology */}
            <div className="bg-panel px-2.5 py-2">
              <p className="font-mono text-[9px] uppercase tracking-widest text-ghost">
                VALUATION METHOD
              </p>
              <p className="mt-1 text-[12px] leading-snug text-ink">
                {methodDetail}
              </p>
              <div className="mt-1.5 grid grid-cols-2 gap-px bg-hairline">
                {[
                  {
                    k: "TGT P/E MULTIPLE",
                    v: active.targetPeUsed != null ? fmtX(active.targetPeUsed, 1) : "—",
                  },
                  {
                    k: "DIVIDEND FLOOR",
                    v: fmtPrice(active.dividendFloorPkr),
                  },
                  {
                    k: "VALUATION SPREAD",
                    v: fmtPct(active.valuationDiscountPct, 1),
                  },
                  {
                    k: "STATUS",
                    v: active.valuationStatus.replace(/_/g, " "),
                  },
                ].map((s) => (
                  <div key={s.k} className="bg-panel px-1.5 py-1">
                    <p className="font-mono text-[9px] uppercase tracking-widest text-ghost">
                      {s.k}
                    </p>
                    <p className="font-mono text-[11px] tabular-nums text-ink">
                      {s.v}
                    </p>
                  </div>
                ))}
              </div>
            </div>

            {/* Catalyst timeline */}
            <div className="bg-panel px-2.5 py-2">
              <p className="font-mono text-[9px] uppercase tracking-widest text-ghost">
                CATALYST TIMELINE — STORED EVENTS
              </p>
              {events.length === 0 ? (
                <p className="mt-1 font-mono text-[11px] text-ghost">
                  NO STORED EVENTS FOR THIS NAME
                </p>
              ) : (
                <ol className="mt-1 space-y-1">
                  {events.map((e, i) => (
                    <li key={`${e.date}-${i}`} className="flex items-center gap-2">
                      <span className="font-mono text-[10px] tabular-nums text-ghost">
                        {e.date}
                      </span>
                      <Badge tone={e.tone}>{e.label}</Badge>
                    </li>
                  ))}
                </ol>
              )}
              <p className="mt-2 font-mono text-[9px] uppercase tracking-widest text-ghost">
                MOAT ANALYSIS
              </p>
              <p className="mt-0.5 font-mono text-[11px] text-warn">
                NOT SCORED — QUALITATIVE FEED PENDING (NEVER SYNTHESIZED)
              </p>
            </div>
          </div>

          {/* Signal narrative — real rationales */}
          {whale && (
            <div className="border-t border-hairline px-2.5 py-2">
              <p className="font-mono text-[9px] uppercase tracking-widest text-ghost">
                DESK NARRATIVE — LIVE SIGNAL RATIONALE
